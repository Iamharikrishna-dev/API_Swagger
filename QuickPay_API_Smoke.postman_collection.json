              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Transactions return HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test('Transactions response is an array', function () { pm.expect(b).to.be.an('array'); });",
                  "pm.test('Transactions do not exceed 100 records', function () { pm.expect(b.length).to.be.at.most(100); });",
                  "const pid = pm.collectionVariables.get('paymentId');",
                  "if (pid) { const match = b.find(function (t) { return String(t.paymentId) === String(pid); }); pm.test('Successful payment appears in transaction history', function () { pm.expect(match, 'transaction for payment ' + pid).to.exist; }); if (match) pm.collectionVariables.set('transactionId', String(match.id || '')); }"
                ]
              }
            }
          ]
        },
