  "item": [
    {
      "name": "01 - Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Health response is JSON', function () { pm.response.to.be.json; });",
                  "const b = pm.response.json();",
                  "pm.test('Health response contains status', function () { pm.expect(b).to.have.property('status'); });",
                  "pm.test('Health status is UP', function () { pm.expect(b.status).to.eql('UP'); });",
                  "pm.test('Health response contains service', function () { pm.expect(b).to.have.property('service'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Authentication",
      "item": [
        {
          "name": "Signup - valid new customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueEmail = 'qa-' + Date.now() + '-' + Math.floor(Math.random() * 10000) + '@example.test';",
                  "pm.collectionVariables.set('email', uniqueEmail);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"{{phone}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signup returns expected HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Signup response is JSON', function () { pm.response.to.be.json; });",
                  "const b = pm.response.json();",
                  "pm.test('Signup response includes token', function () { pm.expect(b.token).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('token', b.token || '');",
                  "if (b.customer && b.customer.id !== undefined) pm.collectionVariables.set('customerId', String(b.customer.id));",
                  "pm.test('Customer summary is present when returned', function () { if (b.customer !== undefined) pm.expect(b.customer).to.be.an('object'); });"
                ]
              }
            }
          ]
        },
