    {
      "name": "03 - Customer and Authentication Security",
      "item": [
        {
          "name": "Get my profile - authenticated",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test('Profile includes email', function () { pm.expect(b.email).to.be.a('string'); });",
                  "pm.test('Profile includes balance', function () { pm.expect(b).to.have.property('balance'); pm.expect(Number(b.balance)).to.be.a('number'); });",
                  "pm.test('Profile does not expose password fields', function () { pm.expect(b).not.to.have.any.keys('password', 'passwordHash', 'password_hash'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my profile - no token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/customers/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "me"]
