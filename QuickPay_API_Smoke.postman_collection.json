    {
      "name": "04 - Merchants",
      "item": [
        {
          "name": "List active merchants",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/merchants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "merchants"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Merchant list returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test('Merchant list is an array', function () { pm.expect(b).to.be.an('array'); });",
                  "pm.test('Each merchant has an ID and name', function () { b.forEach(function (m) { pm.expect(m).to.have.property('id'); pm.expect(m.name).to.be.a('string'); }); });",
                  "pm.test('Inactive merchant is not listed when status is represented', function () { b.forEach(function (m) { if (m.status !== undefined) pm.expect(String(m.status).toUpperCase()).not.to.eql('INACTIVE'); }); });"
                ]
              }
            }
          ]
        }
      ]
    },
