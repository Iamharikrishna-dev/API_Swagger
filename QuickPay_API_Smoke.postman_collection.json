                  "const b = pm.response.json();",
                  "pm.test('Payment response contains payment ID', function () { pm.expect(b.paymentId).to.be.a('string').and.not.empty; });",
                  "pm.test('Payment response amount matches request', function () { pm.expect(Number(b.amount)).to.eql(Number(pm.collectionVariables.get('paymentAmount'))); });",
                  "pm.test('Payment response contains status', function () { pm.expect(b.status).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('paymentId', b.paymentId || '');"
                ]
